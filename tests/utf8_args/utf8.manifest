<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The test program's manifest on Windows: the process's ANSI code page is
     UTF-8 (Windows 10 1903 and later), as in a program that uses
     recomp_utf8_args.c for real. Without it the "command line" test could
     not tell a working conversion from a missing one. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
